---
import Logo from '../common/Logo.astro';
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import { site, getWhatsAppUrl, getPhoneTel } from '../../data/site';

const navLinks = [
  { 
    label: 'Inicio', 
    href: '#inicio', 
    id: 'inicio',
    subtext: 'Configurador de pedidos y catálogo directo',
  },
  { 
    label: 'Quiénes somos', 
    href: '#nosotros', 
    id: 'nosotros',
    subtext: 'Nuestra trayectoria, misión y valores',
  },
  { 
    label: 'Productos', 
    href: '#productos', 
    id: 'productos',
    subtext: 'Balones de 10 kg y 45 kg con especificaciones',
  },
  { 
    label: 'Contacto', 
    href: '#contacto', 
    id: 'contacto',
    subtext: 'Zonas de cobertura en Chiclayo y distritos',
  },
];

const headerWhatsAppUrl = getWhatsAppUrl(`Hola ${site.brand}, deseo pedir gas.`);
const phoneTel = getPhoneTel();
---

<!-- Cabecera Principal -->
<header
  id="main-header"
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md transition-all duration-300 border-b border-transparent"
>
  <div class="mx-auto flex h-20 max-w-site items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <!-- Logotipo Oficial Línea Gas -->
    <a href="#inicio" class="flex items-center gap-2 rounded-xl py-1 focus-visible:ring-2 focus-visible:ring-brand-orange-dark transition" aria-label="Ir al inicio de Línea Gas">
      <Logo variant="dark" />
    </a>

    <!-- Navegación de Escritorio: Cápsula Flotante Moderna con Indicador Activo y Efecto Pill -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-8" aria-label="Navegación principal">
      
      <!-- Cápsula Segmentada de Navegación -->
      <div class="flex items-center p-1.5 rounded-full bg-slate-100/90 border border-slate-200/90 shadow-2xs backdrop-blur-sm">
        <ul class="flex items-center gap-1 text-[13px] font-bold text-slate-600">
          {navLinks.map((link, index) => {
            const isFirst = index === 0;
            return (
              <li>
                <a
                  href={link.href}
                  data-nav-target={link.id}
                  class={`desktop-nav-link group relative flex items-center gap-2 rounded-full px-4 py-2 transition-all duration-200 select-none ${
                    isFirst
                      ? "bg-white text-brand-navy shadow-xs font-extrabold active-nav ring-1 ring-slate-200/60"
                      : "text-slate-600 hover:text-brand-navy hover:bg-white/80"
                  }`}
                >
                  <!-- Indicador de acento naranja animado -->
                  <span
                    class={`nav-dot h-2 w-2 rounded-full bg-brand-orange transition-all duration-300 ${
                      isFirst ? "scale-100 opacity-100 ring-2 ring-orange-200" : "scale-0 opacity-0 group-hover:scale-75 group-hover:opacity-60"
                    }`}
                  ></span>

                  <!-- Texto de la opción -->
                  <span class="tracking-wide">{link.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Botón CTA Pedir Gas (Verde Oficial WhatsApp) -->
      {headerWhatsAppUrl ? (
        <a
          href={headerWhatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="relative inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] px-5 py-2.5 text-xs sm:text-sm font-extrabold text-white shadow-md shadow-emerald-500/20 transition-all duration-200 hover:shadow-lg hover:shadow-emerald-500/30 hover:scale-[1.02] active:scale-95 cursor-pointer"
        >
          <span class="flex h-2 w-2 rounded-full bg-white animate-pulse"></span>
          <WhatsAppIcon className="h-4 w-4" size={17} />
          <span>Pedir gas</span>
        </a>
      ) : (
        <button
          type="button"
          class="btn-demo-action relative inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] px-5 py-2.5 text-xs sm:text-sm font-extrabold text-white shadow-md shadow-emerald-500/20 transition-all duration-200 hover:shadow-lg hover:shadow-emerald-500/30 hover:scale-[1.02] active:scale-95 cursor-pointer"
          data-msg={`Hola ${site.brand}, deseo consultar por un pedido de gas.`}
          data-context="El botón principal de pedido conectará con el WhatsApp oficial tan pronto se configure el número."
        >
          <span class="flex h-2 w-2 rounded-full bg-white animate-pulse"></span>
          <WhatsAppIcon className="h-4 w-4" size={17} />
          <span>Pedir gas</span>
        </button>
      )}
    </nav>

    <!-- Botón Menú Móvil (Hamburguesa / Cerrar) -->
    <div class="flex items-center md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-brand-navy hover:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange-dark transition cursor-pointer select-none"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <svg id="menu-icon-open" class="h-6 w-6 block pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="h-6 w-6 hidden pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Panel Menú Móvil Pantalla Completa: Fondo Azul Marino (#11185C), Logo Blanco, Enlaces Centrados y Facebook -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden md:hidden bg-[#11185C] overflow-y-auto text-white select-none transition-all duration-300"
  style="height: 100vh; height: 100dvh;"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación para dispositivos móviles"
>
  <!-- Botón Cerrar (X blanca) en la esquina superior izquierda como en la referencia -->
  <div class="absolute top-5 left-5 z-20">
    <button
      id="mobile-menu-close-btn"
      type="button"
      class="inline-flex h-12 w-12 items-center justify-center text-white/90 hover:text-white transition active:scale-90 cursor-pointer"
      aria-label="Cerrar menú"
    >
      <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Contenedor Flex: Logo arriba, Enlaces al centro vertical, Redes Sociales al pie -->
  <div class="min-h-full h-full flex flex-col justify-between items-center py-12 px-6 max-w-sm mx-auto">
    
    <!-- 1. Logo Superior Centrado Más Grande (Líneas blancas sobre fondo azul) -->
    <div class="w-full flex justify-center pt-2">
      <a href="#inicio" class="mobile-nav-link inline-block">
        <img
          src="/images/logoOscuro.webp"
          alt="Línea Gas"
          class="h-20 sm:h-24 w-auto max-w-[240px] sm:max-w-[280px] object-contain mx-auto transition-transform active:scale-95"
          width="240"
          height="88"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <!-- 2. Menú de Secciones Centrado (Ubicado a la mitad de la pantalla) -->
    <nav class="w-full py-8 space-y-6 sm:space-y-7 text-center">
      {navLinks.map((link) => (
        <div>
          <a
            href={link.href}
            data-nav-target={link.id}
            class="mobile-nav-link font-heading text-xl sm:text-2xl font-medium tracking-wide text-white hover:text-brand-orange active:text-brand-orange transition-colors inline-block py-1 px-4 cursor-pointer"
          >
            {link.label}
          </a>
        </div>
      ))}
    </nav>

    <!-- 3. Pie Inferior: Redes Sociales (Facebook en círculo blanco como en la referencia) -->
    <div class="w-full text-center pb-2">
      <p class="text-sm font-medium text-white/80 mb-3 tracking-wide">
        Redes Sociales
      </p>
      <div class="flex items-center justify-center">
        <a
          href="https://www.facebook.com/share/1E2nh4naHH/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/50 text-white hover:border-white hover:bg-white/10 active:scale-95 transition-all"
          aria-label="Facebook de Línea Gas"
        >
          <img
            src="/images/facebook.svg"
            alt="Facebook"
            class="h-5 w-5 brightness-0 invert"
            width="20"
            height="20"
          />
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  const header = document.getElementById('main-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const desktopLinks = document.querySelectorAll('.desktop-nav-link');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  // Sombra y borde sutil al hacer scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('shadow-md', 'border-slate-200/80');
      header?.classList.remove('border-transparent');
    } else {
      header?.classList.remove('shadow-md', 'border-slate-200/80');
      header?.classList.add('border-transparent');
    }
  });

  // Funciones de apertura y cierre de menú móvil
  function closeMobileMenu() {
    if (!menuBtn || !mobileMenu) return;
    menuBtn.setAttribute('aria-expanded', 'false');
    mobileMenu.classList.add('hidden');
    mobileMenu.style.display = 'none';
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function openMobileMenu() {
    if (!menuBtn || !mobileMenu) return;
    menuBtn.setAttribute('aria-expanded', 'true');
    mobileMenu.classList.remove('hidden');
    mobileMenu.style.display = 'block';
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function toggleMobileMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  menuBtn?.addEventListener('click', toggleMobileMenu);
  closeBtn?.addEventListener('click', closeMobileMenu);

  // Cerrar menú al hacer clic en un enlace de navegación
  mobileNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      closeMobileMenu();
      menuBtn.focus();
    }
  });

  // ScrollSpy: Actualizar automáticamente el botón activo según la sección visible
  function setActiveNav(targetId: string) {
    desktopLinks.forEach((link) => {
      const navTarget = link.getAttribute('data-nav-target');
      const dot = link.querySelector('.nav-dot');
      const isTarget = navTarget === targetId;

      if (isTarget) {
        link.classList.add('bg-white', 'text-brand-navy', 'shadow-xs', 'font-extrabold', 'active-nav', 'ring-1', 'ring-slate-200/60');
        link.classList.remove('text-slate-600', 'hover:bg-white/80');
        if (dot) {
          dot.classList.add('scale-100', 'opacity-100', 'ring-2', 'ring-orange-200');
          dot.classList.remove('scale-0', 'opacity-0');
        }
      } else {
        link.classList.remove('bg-white', 'text-brand-navy', 'shadow-xs', 'font-extrabold', 'active-nav', 'ring-1', 'ring-slate-200/60');
        link.classList.add('text-slate-600', 'hover:bg-white/80');
        if (dot) {
          dot.classList.remove('scale-100', 'opacity-100', 'ring-2', 'ring-orange-200');
          dot.classList.add('scale-0', 'opacity-0');
        }
      }
    });
  }

  // Clic directo en enlace de escritorio actualiza el estado inmediatamente
  desktopLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const targetId = link.getAttribute('data-nav-target');
      if (targetId) setActiveNav(targetId);
    });
  });

  // IntersectionObserver para seguir el scroll con precisión
  const sectionIds = ['inicio', 'nosotros', 'productos', 'contacto'];
  const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

  if ('IntersectionObserver' in window && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveNav(entry.target.id);
          }
        });
      },
      {
        rootMargin: '-25% 0px -55% 0px',
        threshold: 0,
      }
    );

    sections.forEach((sec) => observer.observe(sec));
  }
</script>
