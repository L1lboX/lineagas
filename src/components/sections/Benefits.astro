---
import { site } from '../../data/site';
---

<section class="py-6 sm:py-8 bg-slate-50 border-y border-slate-200">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 md:divide-x divide-slate-200 gap-6 md:gap-0">
      
      <!-- Punto 1: Atención directa -->
      <div class="flex items-center gap-3.5 md:px-6 first:md:pl-0">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-100/80 text-brand-orange-dark">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-sm font-bold text-brand-navy">Atención directa sin esperas</h3>
          <p class="text-xs text-content-muted leading-relaxed">
            WhatsApp y central telefónica para pedidos inmediatos y programados.
          </p>
        </div>
      </div>

      <!-- Punto 2: Variedad de marcas -->
      <div class="flex items-center gap-3.5 md:px-6">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-100/80 text-brand-navy">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-sm font-bold text-brand-navy">Marcas de máxima confianza</h3>
          <p class="text-xs text-content-muted leading-relaxed">
            Costagas, Solgas y Sipán Gas en balones de 10 kg y 45 kg Industrial.
          </p>
        </div>
      </div>

      <!-- Punto 3: Seguridad de origen -->
      <div class="flex items-center gap-3.5 md:px-6 last:md:pr-0">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100/80 text-emerald-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-sm font-bold text-brand-navy">Garantía y pesaje exacto</h3>
          <p class="text-xs text-content-muted leading-relaxed">
            Cilindros con precinto íntegro de origen y peso verificado.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
