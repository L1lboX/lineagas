---
import { site } from '../../data/site';

const { about } = site;
---

<section id="nosotros" class="scroll-mt-28 py-14 sm:py-16 lg:py-20 bg-slate-50/60 border-t border-slate-200">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="max-w-2xl">
      <h2 class="font-heading text-3xl font-extrabold text-brand-navy sm:text-4xl">
        {about.title}
      </h2>
      <p class="mt-3 text-base text-content-muted leading-relaxed">
        {about.intro}
      </p>
    </div>

    <!-- Contenido en dos columnas: Fotografía Institucional primero, Historia y Valores después (Diseño Editorial, sin saturación de tarjetas) -->
    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 items-start">
      
      <!-- Columna 1: Fotografía Institucional Real (Limpia y destacada) -->
      <div class="lg:col-span-5 space-y-4 max-w-md mx-auto lg:max-w-none w-full">
        <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-200/80 bg-white group">
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-slate-100">
            <img
              src="/images/fotoInstitucional.webp"
              alt="Instalaciones y equipo institucional de Línea Gas"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
              width="560"
              height="420"
            />
          </div>
          <div class="p-3.5 bg-slate-50/80 border-t border-slate-100">
            <p class="text-xs text-slate-600 leading-relaxed">
              Distribución autorizada con pesaje exacto, precinto íntegro de origen y reparto rápido a domicilio en Chiclayo y distritos de Lambayeque.
            </p>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-content-muted">
          <span>¿Tienes alguna consulta institucional?</span>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center rounded-xl bg-brand-navy hover:bg-brand-navy/90 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all active:scale-95 cursor-pointer text-center"
          >
            Contáctanos aquí
          </a>
        </div>
      </div>

      <!-- Columna 2: Narrativa Institucional (Diseño Editorial fluido, sin cajas artificiales) -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Historia -->
        <div class="space-y-3">
          <h3 class="font-heading text-2xl font-bold text-brand-navy">
            {about.history.title}
          </h3>
          <p class="text-base text-content-muted leading-relaxed">
            {about.history.text}
          </p>
        </div>

        <!-- Misión y Visión con acento tipográfico (sin tarjetas plásticas ni emojis) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2 border-t border-slate-100">
          <div class="border-l-2 border-brand-orange pl-4 space-y-1.5">
            <h4 class="font-heading font-bold text-brand-navy text-base">
              {about.mission.title}
            </h4>
            <p class="text-xs sm:text-sm text-content-muted leading-relaxed">
              {about.mission.text}
            </p>
          </div>

          <div class="border-l-2 border-brand-navy pl-4 space-y-1.5">
            <h4 class="font-heading font-bold text-brand-navy text-base">
              {about.vision.title}
            </h4>
            <p class="text-xs sm:text-sm text-content-muted leading-relaxed">
              {about.vision.text}
            </p>
          </div>
        </div>

        <!-- Valores de la Empresa: Lista limpia y elegante (sin cajas grises) -->
        <div class="pt-2 border-t border-slate-100">
          <h4 class="font-heading text-lg font-bold text-brand-navy mb-4">
            Nuestros Valores
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
            {about.values.map((val) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-orange"></span>
                  <h5 class="text-sm font-bold text-brand-navy">{val.title}</h5>
                </div>
                <p class="text-xs text-content-muted pl-3.5 leading-relaxed">{val.desc}</p>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
