---
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import { site, getWhatsAppUrl } from '../../data/site';

const bannerMsg = `Hola ${site.brand}, tengo dudas sobre qué presentación de gas elegir. ¿Me pueden asesorar?`;
const bannerWhatsAppUrl = getWhatsAppUrl(bannerMsg);
---

<section class="relative overflow-hidden bg-brand-navy py-12 px-4 sm:px-6 lg:px-8 text-white">
  <!-- Efecto decorativo de gradiente cálido en la esquina -->
  <div class="absolute -right-16 -bottom-16 h-48 w-48 rounded-full bg-gradient-to-tr from-brand-orange to-brand-yellow opacity-20 blur-2xl pointer-events-none" aria-hidden="true"></div>

  <div class="mx-auto max-w-site flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-center md:text-left space-y-1">
      <h2 class="font-heading text-2xl font-extrabold sm:text-3xl text-white">
        ¿Tienes dudas sobre qué presentación necesitas?
      </h2>
      <p class="text-slate-300 text-sm sm:text-base">
        Escríbenos directamente y nuestro equipo te asesorará con la mejor opción para tu hogar o negocio.
      </p>
    </div>

    <div class="shrink-0 w-full md:w-auto">
      {bannerWhatsAppUrl ? (
        <a
          href={bannerWhatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full md:w-auto items-center justify-center gap-2.5 rounded-btn bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] px-7 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-emerald-950/20 hover:brightness-105 transition active:scale-95"
        >
          <WhatsAppIcon className="h-5 w-5" size={20} />
          Hablar por WhatsApp
        </a>
      ) : (
        <button
          type="button"
          class="btn-demo-action inline-flex w-full md:w-auto items-center justify-center gap-2.5 rounded-btn bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] px-7 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-emerald-950/20 hover:brightness-105 transition active:scale-95"
          data-msg={bannerMsg}
          data-context="Asesoría directa sobre marcas y presentaciones de gas."
        >
          <WhatsAppIcon className="h-5 w-5" size={20} />
          Hablar por WhatsApp
        </button>
      )}
    </div>
  </div>
</section>
