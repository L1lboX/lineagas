---
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import ChiclayoMap from '../ui/ChiclayoMap.astro';
import { site, getWhatsAppUrl, getPhoneTel } from '../../data/site';

const { contact } = site;
const whatsappUrl = getWhatsAppUrl(`Hola ${site.brand}, deseo consultar si tienen cobertura en mi zona para un pedido de gas.`);
const phoneTel = getPhoneTel();
---

<section id="contacto" class="py-16 lg:py-24 bg-white border-t border-slate-200">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-brand-navy">
        Zonas de Reparto en la Provincia de Chiclayo
      </h2>
      <p class="mt-3 text-base text-content-muted leading-relaxed">
        Contamos con despacho directo en los distritos de la provincia. Consulta la disponibilidad en el mapa interactivo o contáctanos por WhatsApp o llamada directa:
      </p>
    </div>

    <!-- Grid Dos Columnas: Columna 1 (Mapa Vectorial Exacto) & Columna 2 (Canales de Atención) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Columna 1: Mapa SVG Exacto de Cobertura en Chiclayo -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center max-w-lg mx-auto lg:max-w-none w-full">
        <ChiclayoMap />
      </div>

      <!-- Columna 2: Datos de Contacto Directo y Canales de Pedidos (Diseño Limpio y Abierto) -->
      <div class="lg:col-span-5 space-y-6 max-w-lg mx-auto lg:max-w-none w-full">
        
        <div>
          <h3 class="font-heading text-xl sm:text-2xl font-extrabold text-brand-navy">
            Canales Directos de Pedidos
          </h3>
          <p class="mt-1 text-xs sm:text-sm text-content-muted leading-relaxed">
            Comunícate directamente con nuestro equipo de despacho para verificar stock y coordinar tu entrega.
          </p>
        </div>

        <!-- Contenedores Clickeables e Interactivos -->
        <div class="space-y-3.5">
          
          <!-- Contenedor 1: WhatsApp de Pedidos Clickeable -->
          {whatsappUrl ? (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group block w-full rounded-xl border border-emerald-500/30 bg-emerald-50/30 p-3 sm:p-3.5 shadow-2xs transition-all duration-200 hover:border-emerald-500 hover:bg-emerald-50/70 hover:shadow-md hover:shadow-emerald-500/10 active:scale-[0.99] cursor-pointer"
              aria-label={`Pedir gas por WhatsApp al +${contact.whatsappNumber}`}
            >
              <div class="flex items-center gap-3 sm:gap-3.5">
                <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] text-white shadow-xs transition-transform duration-200 group-hover:scale-105">
                  <WhatsAppIcon className="h-5 w-5 sm:h-6 sm:w-6" size={22} />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-800">
                      WhatsApp de Pedidos
                    </p>
                    <span class="inline-flex items-center gap-1 rounded-md bg-emerald-100/90 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 transition-colors group-hover:bg-emerald-200">
                      Chatear <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                    </span>
                  </div>
                  <p class="text-sm sm:text-base font-bold text-slate-800 transition-colors group-hover:text-emerald-700 truncate mt-0.5">
                    {contact.whatsappNumber}
                  </p>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Atención y despacho inmediato
                  </p>
                </div>
              </div>
            </a>
          ) : (
            <button
              type="button"
              class="btn-demo-action group block w-full text-left rounded-xl border border-emerald-500/30 bg-emerald-50/30 p-3 sm:p-3.5 shadow-2xs transition-all duration-200 hover:border-emerald-500 hover:bg-emerald-50/70 hover:shadow-md hover:shadow-emerald-500/10 active:scale-[0.99] cursor-pointer"
              data-msg="Consulta de pedidos para Chiclayo"
              data-context="Línea de WhatsApp oficial de Línea Gas."
            >
              <div class="flex items-center gap-3 sm:gap-3.5">
                <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] text-white shadow-xs transition-transform duration-200 group-hover:scale-105">
                  <WhatsAppIcon className="h-5 w-5 sm:h-6 sm:w-6" size={22} />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-800">
                      WhatsApp de Pedidos
                    </p>
                    <span class="inline-flex items-center gap-1 rounded-md bg-emerald-100/90 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 transition-colors group-hover:bg-emerald-200">
                      Chatear <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                    </span>
                  </div>
                  <p class="text-sm sm:text-base font-bold text-slate-800 transition-colors group-hover:text-emerald-700 truncate mt-0.5">
                    {contact.whatsappNumber || "51 987 654 321"}
                  </p>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Atención y despacho inmediato
                  </p>
                </div>
              </div>
            </button>
          )}

          <!-- Contenedor 2: Central Telefónica Clickeable -->
          {phoneTel ? (
            <a
              href={phoneTel}
              class="group block w-full rounded-xl border border-slate-200 bg-white p-3 sm:p-3.5 shadow-2xs transition-all duration-200 hover:border-brand-navy hover:bg-slate-50/80 hover:shadow-md hover:shadow-brand-navy/5 active:scale-[0.99] cursor-pointer"
              aria-label={`Llamar a central telefónica: ${contact.phoneNumber || "(01) 613-3333"}`}
            >
              <div class="flex items-center gap-3 sm:gap-3.5">
                <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-brand-navy text-white shadow-xs transition-transform duration-200 group-hover:scale-105">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-5.5 sm:w-5.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                      Central Telefónica
                    </p>
                    <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-brand-navy transition-colors group-hover:bg-brand-navy group-hover:text-white">
                      Llamar <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                    </span>
                  </div>
                  <p class="text-sm sm:text-base font-bold text-slate-800 transition-colors group-hover:text-brand-navy truncate mt-0.5">
                    {contact.phoneNumber || "(01) 613-3333"}
                  </p>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Llamadas directas para pedidos
                  </p>
                </div>
              </div>
            </a>
          ) : (
            <div class="block w-full rounded-xl border border-slate-200 bg-white p-3 sm:p-3.5 shadow-2xs">
              <div class="flex items-center gap-3 sm:gap-3.5">
                <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-brand-navy text-white shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-5.5 sm:w-5.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Central Telefónica</p>
                  <p class="text-sm sm:text-base font-bold text-slate-800 truncate mt-0.5">(01) 613-3333</p>
                  <p class="text-[11px] text-slate-500 mt-0.5">Llamadas directas para pedidos</p>
                </div>
              </div>
            </div>
          )}

          <!-- Horario de Despacho (Informativo, limpio y compacto) -->
          <div class="flex items-center gap-3.5 rounded-xl bg-slate-50 border border-slate-200/80 p-3.5 text-xs text-slate-600">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Horario de Despacho Continuo</p>
              <p class="text-slate-600 mt-0.5">{contact.businessHours} • Lunes a Domingo</p>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
