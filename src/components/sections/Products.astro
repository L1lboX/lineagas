---
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import { site } from '../../data/site';

const { contact } = site;
const cleanPhone = contact.whatsappNumber.replace(/\D/g, '');
---

<section id="productos" class="scroll-mt-28 py-14 sm:py-20 lg:py-24 bg-white border-t border-slate-200">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-navy tracking-tight">
        Nuestros Balones de Gas
      </h2>
      <p class="mt-3 text-sm sm:text-base md:text-lg text-content-muted leading-relaxed font-medium">
        Balones y kits certificados con peso exacto, seguridad garantizada y entrega inmediata en Chiclayo.
      </p>
    </div>

    <!-- 3 Vitrinas Horizontales Planas y Limpias (Sin Contenedores Anidados) -->
    <div class="divide-y divide-slate-200/80">
      
      <!-- ============================================== -->
      <!-- VITRINA 1: BALONES DE 10 KG -->
      <!-- ============================================== -->
      <div class="py-10 sm:py-14 lg:py-16 first:pt-0">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Imagen Grande y Nítida directamente sobre el fondo limpio -->
          <div class="md:col-span-5 lg:col-span-6 flex items-center justify-center">
            <img
              id="showcase-img-10"
              src="/images/products/solGas.webp"
              alt="Balón de 10 kg Solgas en Chiclayo"
              class="w-auto h-64 sm:h-72 md:h-80 lg:h-96 max-h-[380px] object-contain drop-shadow-lg transition-all duration-300 hover:scale-105 select-none"
              loading="lazy"
              decoding="async"
              width="360"
              height="380"
            />
          </div>

          <!-- Contenido Plano: Título, Selectores Simples y Botón Verde WhatsApp -->
          <div class="md:col-span-7 lg:col-span-6 space-y-5 sm:space-y-6 text-center md:text-left flex flex-col items-center md:items-start">
            <h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy">
              Balones de 10 kg
            </h3>

            <!-- Botones Selectores Simples de Marca -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
              <button
                type="button"
                class="brand-btn-10 active-btn-10 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-brand-navy text-white shadow-xs"
                data-name="Solgas 10 kg"
                data-img="/images/products/solGas.webp"
                data-msg="Hola Línea Gas, deseo pedir un balón de 10 kg de Solgas a domicilio en Chiclayo."
              >
                Solgas
              </button>
              <button
                type="button"
                class="brand-btn-10 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700"
                data-name="Costagas 10 kg"
                data-img="/images/products/costaGas.webp"
                data-msg="Hola Línea Gas, deseo pedir un balón de 10 kg de Costagas a domicilio en Chiclayo."
              >
                Costagas
              </button>
              <button
                type="button"
                class="brand-btn-10 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700"
                data-name="Sipán Gas 10 kg"
                data-img="/images/products/sipanGas.webp"
                data-msg="Hola Línea Gas, deseo pedir un balón de 10 kg de Sipán Gas a domicilio en Chiclayo."
              >
                Sipán Gas
              </button>
            </div>

            <!-- Botón Dinámico de WhatsApp -->
            <div class="pt-2 w-full sm:w-auto">
              <a
                id="showcase-wa-10"
                href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent('Hola Línea Gas, deseo pedir un balón de 10 kg de Solgas a domicilio en Chiclayo.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] hover:brightness-105 active:scale-95 px-8 py-4 text-sm sm:text-base font-extrabold text-white shadow-md shadow-emerald-600/20 transition-all cursor-pointer"
              >
                <WhatsAppIcon className="h-5 w-5 shrink-0" size={20} />
                <span>Pedir por WhatsApp</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- ============================================== -->
      <!-- VITRINA 2: CILINDROS DE 45 KG -->
      <!-- ============================================== -->
      <div class="py-10 sm:py-14 lg:py-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Imagen Grande y Nítida directamente sobre el fondo limpio -->
          <div class="md:col-span-5 lg:col-span-6 flex items-center justify-center">
            <img
              id="showcase-img-45"
              src="/images/products/solGas45.webp"
              alt="Cilindro de 45 kg Solgas Industrial en Chiclayo"
              class="w-auto h-64 sm:h-72 md:h-80 lg:h-96 max-h-[380px] object-contain drop-shadow-lg transition-all duration-300 hover:scale-105 select-none"
              loading="lazy"
              decoding="async"
              width="360"
              height="380"
            />
          </div>

          <!-- Contenido Plano: Título, Selectores Simples y Botón Verde WhatsApp -->
          <div class="md:col-span-7 lg:col-span-6 space-y-5 sm:space-y-6 text-center md:text-left flex flex-col items-center md:items-start">
            <h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy">
              Cilindros de 45 kg
            </h3>

            <!-- Botones Selectores Simples de Marca -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
              <button
                type="button"
                class="brand-btn-45 active-btn-45 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-brand-navy text-white shadow-xs"
                data-name="Solgas 45 kg Industrial"
                data-img="/images/products/solGas45.webp"
                data-msg="Hola Línea Gas, deseo cotizar cilindros de 45 kg de Solgas para mi negocio en Chiclayo."
              >
                Solgas
              </button>
              <button
                type="button"
                class="brand-btn-45 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700"
                data-name="Costagas 45 kg Industrial"
                data-img="/images/products/costaGas45.webp"
                data-msg="Hola Línea Gas, deseo cotizar cilindros de 45 kg de Costagas para mi negocio en Chiclayo."
              >
                Costagas
              </button>
            </div>

            <!-- Botón Dinámico de WhatsApp -->
            <div class="pt-2 w-full sm:w-auto">
              <a
                id="showcase-wa-45"
                href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent('Hola Línea Gas, deseo cotizar cilindros de 45 kg de Solgas para mi negocio en Chiclayo.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] hover:brightness-105 active:scale-95 px-8 py-4 text-sm sm:text-base font-extrabold text-white shadow-md shadow-emerald-600/20 transition-all cursor-pointer"
              >
                <WhatsAppIcon className="h-5 w-5 shrink-0" size={20} />
                <span>Pedir por WhatsApp</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- ============================================== -->
      <!-- VITRINA 3: KITS DE REGULADOR Y VÁLVULA -->
      <!-- ============================================== -->
      <div class="py-10 sm:py-14 lg:py-16 last:pb-0">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Imagen Grande y Nítida directamente sobre el fondo limpio -->
          <div class="md:col-span-5 lg:col-span-6 flex items-center justify-center">
            <img
              id="showcase-img-kit"
              src="/images/products/valvulaSolgas.webp"
              alt="Kit de Regulador y Válvula de gas en Chiclayo"
              class="w-auto h-52 sm:h-60 md:h-68 lg:h-72 max-h-[300px] object-contain drop-shadow-md transition-all duration-300 hover:scale-105 select-none"
              loading="lazy"
              decoding="async"
              width="360"
              height="300"
            />
          </div>

          <!-- Contenido Plano: Título, Selectores Simples y Botón Verde WhatsApp -->
          <div class="md:col-span-7 lg:col-span-6 space-y-5 sm:space-y-6 text-center md:text-left flex flex-col items-center md:items-start">
            <h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy">
              Kits de Regulador y Válvula
            </h3>

            <!-- Botones Selectores Simples de Marca -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
              <button
                type="button"
                class="brand-btn-kit active-btn-kit px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-brand-navy text-white shadow-xs"
                data-name="Kit Regulador Solgas"
                data-img="/images/products/valvulaSolgas.webp"
                data-msg="Hola Línea Gas, deseo pedir el Kit de Regulador y accesorios de Solgas para Chiclayo."
              >
                Kit Solgas
              </button>
              <button
                type="button"
                class="brand-btn-kit px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700"
                data-name="Kit Regulador Costagas"
                data-img="/images/products/valvulaPrmCosta.webp"
                data-msg="Hola Línea Gas, deseo pedir el Kit de Regulador y accesorios de Costagas para Chiclayo."
              >
                Kit Costagas
              </button>
            </div>

            <!-- Botón Dinámico de WhatsApp -->
            <div class="pt-2 w-full sm:w-auto">
              <a
                id="showcase-wa-kit"
                href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent('Hola Línea Gas, deseo pedir el Kit de Regulador y accesorios de Solgas para Chiclayo.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] hover:brightness-105 active:scale-95 px-8 py-4 text-sm sm:text-base font-extrabold text-white shadow-md shadow-emerald-600/20 transition-all cursor-pointer"
              >
                <WhatsAppIcon className="h-5 w-5 shrink-0" size={20} />
                <span>Pedir por WhatsApp</span>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<!-- Script Reactivo para las 3 Vitrinas -->
<script define:vars={{ whatsappPhone: cleanPhone }}>
  function setupShowcase(buttonClass, imgId, waBtnId) {
    const buttons = document.querySelectorAll(buttonClass);
    const imgEl = document.getElementById(imgId);
    const waBtn = document.getElementById(waBtnId);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Estado visual de los botones
        buttons.forEach((b) => {
          b.classList.remove('bg-brand-navy', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-brand-navy', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        const newImg = btn.getAttribute('data-img');
        const newName = btn.getAttribute('data-name');
        const newMsg = btn.getAttribute('data-msg');

        // Transición suave de la imagen
        if (imgEl && newImg) {
          imgEl.style.opacity = '0.3';
          imgEl.style.transform = 'scale(0.96)';
          setTimeout(() => {
            imgEl.src = newImg;
            if (newName) imgEl.alt = `${newName} en Chiclayo`;
            imgEl.style.opacity = '1';
            imgEl.style.transform = 'scale(1)';
          }, 90);
        }

        // Actualización dinámica del mensaje de WhatsApp
        if (waBtn && newMsg) {
          waBtn.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(newMsg)}`;
        }
      });
    });
  }

  // Inicializar las 3 vitrinas
  setupShowcase('.brand-btn-10', 'showcase-img-10', 'showcase-wa-10');
  setupShowcase('.brand-btn-45', 'showcase-img-45', 'showcase-wa-45');
  setupShowcase('.brand-btn-kit', 'showcase-img-kit', 'showcase-wa-kit');
</script>
