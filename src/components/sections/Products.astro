---
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import { site } from '../../data/site';

const { brands, contact } = site;
---

<section id="productos" class="py-2.5 sm:py-7 lg:py-10 bg-surface-soft border-t border-slate-200">
  <div class="mx-auto max-w-site px-[35px] sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección de Productos -->
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="font-heading text-xl sm:text-2xl lg:text-3xl font-extrabold text-brand-navy">
        Nuestras Marcas y Presentaciones
      </h2>
      <p class="mt-1 sm:mt-1.5 text-xs sm:text-sm md:text-base text-content-muted leading-relaxed">
        Balones de <strong>10 kg</strong> (Regular y Premium) para el hogar y balones de <strong>45 kg Industrial</strong> para alta demanda comercial.
      </p>
    </div>

    <!-- Grid de las 3 Marcas: Dimensiones Proporcionales y Homogéneas -->
    <div class="mt-3.5 sm:mt-5 grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 lg:gap-6 items-stretch w-full max-w-xl md:max-w-none mx-auto">
      {brands.map((brand) => (
        <div class="brand-spec-card flex flex-col justify-between rounded-3xl bg-white p-4 sm:p-5 md:p-6 shadow-md border border-slate-200/90 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 h-full w-full">
          
          <div class="flex flex-col flex-1">
            
            <!-- Cabecera de la Marca -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 gap-2">
              <div>
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-brand-orange-dark">
                  {brand.badge}
                </span>
                <h3 class="font-heading text-xl font-extrabold text-brand-navy">
                  {brand.name}
                </h3>
              </div>

              <!-- Selector o Insignia de Presentaciones según la marca -->
              {brand.has45kg ? (
                <div class="flex items-center gap-1 p-0.5 bg-slate-100 rounded-lg border border-slate-200 text-[10px] font-bold shrink-0">
                  <button
                    type="button"
                    class={`spec-tab-btn spec-tab-${brand.id} active-tab px-2 py-0.5 rounded-md bg-brand-navy text-white transition-all shadow-2xs cursor-pointer`}
                    data-brand={brand.id}
                    data-index="0"
                    data-size="10"
                  >
                    10 kg
                  </button>
                  <button
                    type="button"
                    class={`spec-tab-btn spec-tab-${brand.id} px-2 py-0.5 rounded-md text-slate-600 hover:text-brand-navy transition-all cursor-pointer`}
                    data-brand={brand.id}
                    data-index="1"
                    data-size="45"
                  >
                    45 kg
                  </button>
                  {brand.hasValve && (
                    <button
                      type="button"
                      class={`spec-tab-btn spec-tab-${brand.id} px-2 py-0.5 rounded-md text-slate-600 hover:text-brand-navy transition-all cursor-pointer`}
                      data-brand={brand.id}
                      data-index="2"
                      data-size="valve"
                    >
                      Kit
                    </button>
                  )}
                </div>
              ) : (
                <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-extrabold text-brand-navy border border-blue-200 shrink-0">
                  10 kg
                </span>
              )}
            </div>

            <!-- Contenedor Unificado de Imagen con Carrusel (Altura Fija Estable) -->
            <div 
              class="carousel-card-container relative my-3 sm:my-4 w-full h-40 sm:h-44 md:h-48 flex items-center justify-center rounded-2xl bg-slate-50/80 p-2.5 sm:p-3 border border-slate-100 overflow-hidden group select-none shrink-0"
              data-brand={brand.id}
            >
              <img
                id={`catalog-img-${brand.id}`}
                src={brand.image}
                alt={`Balón ${brand.name}`}
                class="catalog-img w-auto h-full max-h-[92%] max-w-[88%] object-contain drop-shadow-md transition-all duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
                width="200"
                height="192"
              />

              {brand.has45kg && (
                <>
                  <!-- Flechas para pasar manual -->
                  <button
                    type="button"
                    class="carousel-arrow-btn carousel-prev absolute left-1.5 top-1/2 -translate-y-1/2 h-7 w-7 rounded-full bg-white/90 hover:bg-white text-slate-700 hover:text-brand-navy shadow-sm flex items-center justify-center opacity-70 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity cursor-pointer z-10"
                    data-brand={brand.id}
                    data-direction="prev"
                    aria-label="Anterior"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="carousel-arrow-btn carousel-next absolute right-1.5 top-1/2 -translate-y-1/2 h-7 w-7 rounded-full bg-white/90 hover:bg-white text-slate-700 hover:text-brand-navy shadow-sm flex items-center justify-center opacity-70 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity cursor-pointer z-10"
                    data-brand={brand.id}
                    data-direction="next"
                    aria-label="Siguiente"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>

                  <!-- Indicadores de puntos (dots) -->
                  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-10">
                    <button
                      type="button"
                      class={`carousel-dot carousel-dot-${brand.id} h-1.5 w-4 rounded-full bg-brand-navy transition-all duration-300 cursor-pointer`}
                      data-brand={brand.id}
                      data-dot-index="0"
                      aria-label="Ver 10 kg"
                    ></button>
                    <button
                      type="button"
                      class={`carousel-dot carousel-dot-${brand.id} h-1.5 w-1.5 rounded-full bg-slate-300 transition-all duration-300 cursor-pointer`}
                      data-brand={brand.id}
                      data-dot-index="1"
                      aria-label="Ver 45 kg"
                    ></button>
                    {brand.hasValve && (
                      <button
                        type="button"
                        class={`carousel-dot carousel-dot-${brand.id} h-1.5 w-1.5 rounded-full bg-slate-300 transition-all duration-300 cursor-pointer`}
                        data-brand={brand.id}
                        data-dot-index="2"
                        aria-label="Ver Kit"
                      ></button>
                    )}
                  </div>
                </>
              )}
            </div>

            <!-- Descripción de la Marca -->
            <p class="text-xs text-content-muted leading-relaxed mb-3 min-h-[36px]">
              {brand.description}
            </p>

            <!-- Características Comerciales Clave (Integradas limpiamente sin cajas artificiales) -->
            <div class="space-y-1.5 py-1.5 text-xs flex-1 border-t border-slate-100">
              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  ✓
                </span>
                <p class="text-slate-700 leading-snug">
                  {brand.has45kg 
                    ? "Presentaciones disponibles de 10 kg doméstico y 45 kg industrial." 
                    : "Presentación exclusiva de 10 kg para cocinas y hogares familiares."}
                </p>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  ✓
                </span>
                <p class="text-slate-700 leading-snug">
                  Opciones con válvula estándar de perilla o válvula premium de acople rápido.
                </p>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  ✓
                </span>
                <p class="text-slate-700 leading-snug">
                  Precinto de seguridad intacto de fábrica con garantía de pesaje exacto.
                </p>
              </div>
            </div>

          </div>

          <!-- Acciones de Pedido: Botón WhatsApp Profesional y Enlace de Configuración -->
          <div class="mt-3 sm:mt-5 pt-3 border-t border-slate-100 flex flex-col gap-2">
            <a
              id={`catalog-wa-btn-${brand.id}`}
              href={`https://wa.me/${contact.whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(`Hola Línea Gas, deseo pedir un balón de 10 kg de ${brand.name}.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] hover:brightness-105 active:scale-95 py-3 px-4 text-xs sm:text-sm font-extrabold text-white shadow-md shadow-emerald-900/10 transition-all cursor-pointer"
            >
              <WhatsAppIcon className="h-5 w-5 shrink-0" size={20} />
              <span>Pedir por WhatsApp</span>
            </a>

            <button
              type="button"
              data-brand-target={brand.id}
              class="catalog-select-hero-btn w-full text-center text-xs font-bold text-slate-500 hover:text-brand-navy py-1 transition-colors cursor-pointer"
            >
              o configurar pedido arriba en el inicio ↑
            </button>
          </div>

        </div>
      ))}
    </div>

    <!-- Garantías y Certificación al Pie del Catálogo -->
    <div class="mt-4 sm:mt-6 rounded-2xl bg-white p-3.5 sm:p-5 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3.5">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-brand-orange-dark">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h4 class="font-heading text-sm sm:text-base font-bold text-brand-navy">
            Compromiso de Calidad y Pesaje en Cada Entrega
          </h4>
          <p class="text-xs text-content-muted">
            Todos nuestros cilindros pasan por rigurosos controles técnicos antes de salir a reparto en Chiclayo.
          </p>
        </div>
      </div>
      <a
        href="#inicio"
        class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-brand-orange-dark hover:bg-[#A63F05] text-white text-xs sm:text-sm font-bold py-2.5 px-5 shadow-sm transition active:scale-95"
      >
        <span>Ir al pedido arriba</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- Script para el Carrusel Interactivo y Autoplay -->
<script define:vars={{ brandsData: brands, whatsappBase: contact.whatsappNumber }}>
  const brandSlidesMap = {};
  const brandStates = {};

  brandsData.forEach((brand) => {
    const slides = [
      {
        size: '10',
        img: brand.image,
        alt: `Balón ${brand.name} 10 kg`,
        waMsg: `Hola Línea Gas, deseo pedir un balón de 10 kg de ${brand.name}.`
      }
    ];

    if (brand.has45kg && brand.image45) {
      slides.push({
        size: '45',
        img: brand.image45,
        alt: `Cilindro ${brand.name} 45 kg Industrial`,
        waMsg: `Hola Línea Gas, deseo pedir un cilindro de 45 kg de ${brand.name}.`
      });
    }

    if (brand.hasValve && brand.imageValve) {
      slides.push({
        size: 'valve',
        img: brand.imageValve,
        alt: `Kit de Válvula y Regulador ${brand.name}`,
        waMsg: `Hola Línea Gas, deseo consultar o pedir el Kit de válvula/regulador de ${brand.name}.`
      });
    }

    brandSlidesMap[brand.id] = slides;

    if (slides.length > 1) {
      brandStates[brand.id] = {
        currentIndex: 0,
        userInteracted: false,
        intervalId: null
      };
    }
  });

  function setBrandSlide(brandId, slideIndex, isManual = false) {
    const slides = brandSlidesMap[brandId];
    if (!slides || !slides[slideIndex]) return;
    const slide = slides[slideIndex];

    const imgEl = document.getElementById(`catalog-img-${brandId}`);
    const waBtn = document.getElementById(`catalog-wa-btn-${brandId}`);

    // Transición suave de la imagen y ajuste de escala según el tipo
    if (imgEl) {
      imgEl.style.opacity = '0.3';
      imgEl.style.transform = 'scale(0.96)';
      setTimeout(() => {
        imgEl.src = slide.img;
        imgEl.alt = slide.alt;
        if (slide.size === 'valve') {
          // La válvula/kit es horizontal: se ajusta a un tamaño proporcional para no deformar el contenedor
          imgEl.className = 'catalog-img w-auto h-full max-h-[58%] max-w-[62%] object-contain drop-shadow-md transition-all duration-300 group-hover:scale-105';
        } else {
          // Balones de gas verticales
          imgEl.className = 'catalog-img w-auto h-full max-h-[92%] max-w-[88%] object-contain drop-shadow-md transition-all duration-300 group-hover:scale-105';
        }
        imgEl.style.opacity = '1';
        imgEl.style.transform = 'scale(1.0)';
      }, 90);
    }

    // Actualizar botones de pestañas del selector
    const tabs = document.querySelectorAll(`.spec-tab-${brandId}`);
    tabs.forEach((tab) => {
      const idx = parseInt(tab.getAttribute('data-index') || '0', 10);
      if (idx === slideIndex) {
        tab.classList.add('bg-brand-navy', 'text-white', 'shadow-2xs');
        tab.classList.remove('text-slate-600');
      } else {
        tab.classList.remove('bg-brand-navy', 'text-white', 'shadow-2xs');
        tab.classList.add('text-slate-600');
      }
    });

    // Actualizar puntos (dots)
    const dots = document.querySelectorAll(`.carousel-dot-${brandId}`);
    dots.forEach((dot) => {
      const dIdx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
      if (dIdx === slideIndex) {
        dot.className = `carousel-dot carousel-dot-${brandId} h-1.5 w-4 rounded-full bg-brand-navy transition-all duration-300 cursor-pointer`;
      } else {
        dot.className = `carousel-dot carousel-dot-${brandId} h-1.5 w-1.5 rounded-full bg-slate-300 transition-all duration-300 cursor-pointer`;
      }
    });

    // Actualizar enlace de WhatsApp guardando internamente la selección sin cambiar el texto visible
    if (waBtn) {
      const cleanPhone = whatsappBase.replace(/\D/g, '');
      waBtn.href = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(slide.waMsg)}`;
    }

    if (brandStates[brandId]) {
      brandStates[brandId].currentIndex = slideIndex;
      if (isManual) {
        brandStates[brandId].userInteracted = true;
        if (brandStates[brandId].intervalId) {
          clearInterval(brandStates[brandId].intervalId);
          brandStates[brandId].intervalId = null;
        }
      }
    }
  }

  // --- CARRUSEL SINCRONIZADO UNIFICADO ---
  let syncSlideIndex = 0;
  let syncIntervalId = null;
  const multiBrands = Object.keys(brandStates);

  function tickSyncCarousel() {
    syncSlideIndex = (syncSlideIndex + 1) % 3;
    multiBrands.forEach((brandId) => {
      if (!brandStates[brandId].userInteracted) {
        setBrandSlide(brandId, syncSlideIndex, false);
      }
    });
  }

  function startSyncCarousel() {
    if (syncIntervalId) clearInterval(syncIntervalId);
    syncIntervalId = setInterval(tickSyncCarousel, 3500);
  }

  function pauseSyncCarousel() {
    if (syncIntervalId) {
      clearInterval(syncIntervalId);
      syncIntervalId = null;
    }
  }

  // Iniciar carrusel sincronizado para todas las marcas simultáneamente
  startSyncCarousel();

  // Pausar sincronización al pasar el mouse por cualquier tarjeta y reanudar al salir
  multiBrands.forEach((brandId) => {
    const cardContainer = document.querySelector(`.carousel-card-container[data-brand="${brandId}"]`);
    if (cardContainer) {
      cardContainer.addEventListener('mouseenter', pauseSyncCarousel);
      cardContainer.addEventListener('mouseleave', () => {
        startSyncCarousel();
      });
    }
  });

  // Manejar clics manuales en las pestañas del selector
  const allTabs = document.querySelectorAll('.spec-tab-btn');
  allTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const brandId = tab.getAttribute('data-brand');
      const slideIndex = parseInt(tab.getAttribute('data-index') || '0', 10);
      if (brandId) {
        setBrandSlide(brandId, slideIndex, true);
        syncSlideIndex = slideIndex;
        if (brandStates[brandId]) {
          clearTimeout(brandStates[brandId].resumeTimeout);
          brandStates[brandId].resumeTimeout = setTimeout(() => {
            brandStates[brandId].userInteracted = false;
          }, 6000);
        }
      }
    });
  });

  // Manejar clics en las flechas de navegación
  const allArrowBtns = document.querySelectorAll('.carousel-arrow-btn');
  allArrowBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const brandId = btn.getAttribute('data-brand');
      const dir = btn.getAttribute('data-direction');
      if (brandId && brandSlidesMap[brandId]) {
        const slides = brandSlidesMap[brandId];
        const state = brandStates[brandId];
        let nextIdx = dir === 'next' ? state.currentIndex + 1 : state.currentIndex - 1;
        if (nextIdx >= slides.length) nextIdx = 0;
        if (nextIdx < 0) nextIdx = slides.length - 1;
        setBrandSlide(brandId, nextIdx, true);
        syncSlideIndex = nextIdx;
        if (brandStates[brandId]) {
          clearTimeout(brandStates[brandId].resumeTimeout);
          brandStates[brandId].resumeTimeout = setTimeout(() => {
            brandStates[brandId].userInteracted = false;
          }, 6000);
        }
      }
    });
  });

  // Manejar clics en los puntos (dots)
  const allDots = document.querySelectorAll('.carousel-dot');
  allDots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      e.stopPropagation();
      const brandId = dot.getAttribute('data-brand');
      const dIdx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
      if (brandId) {
        setBrandSlide(brandId, dIdx, true);
        syncSlideIndex = dIdx;
        if (brandStates[brandId]) {
          clearTimeout(brandStates[brandId].resumeTimeout);
          brandStates[brandId].resumeTimeout = setTimeout(() => {
            brandStates[brandId].userInteracted = false;
          }, 6000);
        }
      }
    });
  });

  // Conectar botón secundario con el configurador del Hero
  const heroSelectBtns = document.querySelectorAll('.catalog-select-hero-btn');
  heroSelectBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const brandId = btn.getAttribute('data-brand-target');
      if (brandId) {
        const heroBrandBtn = document.querySelector(`.hero-brand-btn[data-brand-id="${brandId}"]`);
        if (heroBrandBtn) {
          heroBrandBtn.click();
        }
        document.getElementById('inicio')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
