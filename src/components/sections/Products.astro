---
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import { site } from '../../data/site';

const { brands, contact } = site;
---

<section id="productos" class="py-14 lg:py-20 bg-surface-soft border-t border-slate-200">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección de Productos -->
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy">
        Nuestras Marcas y Presentaciones
      </h2>
      <p class="mt-2 text-sm sm:text-base text-content-muted leading-relaxed">
        Balones de <strong>10 kg</strong> (Regular y Premium) para el hogar y balones de <strong>45 kg Industrial</strong> para alta demanda comercial.
      </p>
    </div>

    <!-- Grid de las 3 Marcas: Dimensiones Proporcionales y Homogéneas -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch max-w-md md:max-w-none mx-auto w-full">
      {brands.map((brand) => (
        <div class="brand-spec-card flex flex-col justify-between rounded-3xl bg-white p-5 sm:p-6 shadow-md border border-slate-200/90 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 h-full w-full">
          
          <div class="flex flex-col flex-1">
            
            <!-- Cabecera de la Marca -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div>
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-brand-orange-dark">
                  {brand.badge}
                </span>
                <h3 class="font-heading text-xl font-extrabold text-brand-navy">
                  {brand.name}
                </h3>
              </div>

              <!-- Selector o Insignia de Presentaciones según la marca -->
              {brand.has45kg ? (
                <div class="flex items-center gap-1 p-0.5 bg-slate-100 rounded-lg border border-slate-200 text-[10px] font-bold">
                  <button
                    type="button"
                    class="spec-tab-btn active-tab px-2 py-0.5 rounded-md bg-brand-navy text-white transition-all shadow-2xs"
                    data-brand={brand.id}
                    data-img10={brand.image}
                    data-img45={brand.image45}
                    data-size="10"
                  >
                    10 kg
                  </button>
                  <button
                    type="button"
                    class="spec-tab-btn px-2 py-0.5 rounded-md text-slate-600 hover:text-brand-navy transition-all"
                    data-brand={brand.id}
                    data-img10={brand.image}
                    data-img45={brand.image45}
                    data-size="45"
                  >
                    45 kg
                  </button>
                </div>
              ) : (
                <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-extrabold text-brand-navy border border-blue-200">
                  10 kg
                </span>
              )}
            </div>

            <!-- Contenedor Unificado de Imagen (Proporción Limpia y Homogénea) -->
            <div class="relative my-4 w-full h-44 sm:h-48 md:h-52 flex items-center justify-center rounded-2xl bg-slate-50/80 p-4 border border-slate-100 overflow-hidden group">
              <img
                id={`catalog-img-${brand.id}`}
                src={brand.image}
                alt={`Balón ${brand.name}`}
                class="w-auto h-full max-h-[88%] max-w-[85%] object-contain drop-shadow-md transition-all duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Descripción de la Marca -->
            <p class="text-xs text-content-muted leading-relaxed mb-3 min-h-[36px]">
              {brand.description}
            </p>

            <!-- Características Comerciales Clave (Integradas limpiamente sin cajas artificiales) -->
            <div class="space-y-2 py-2 text-xs flex-1 border-t border-slate-100">
              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  ✓
                </span>
                <p class="text-slate-700 leading-snug">
                  {brand.has45kg 
                    ? "Presentaciones disponibles de 10 kg doméstico y 45 kg industrial." 
                    : "Presentación exclusiva de 10 kg para cocinas y hogares familiares."}
                </p>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  ✓
                </span>
                <p class="text-slate-700 leading-snug">
                  Opciones con válvula estándar de perilla o válvula premium de acople rápido.
                </p>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  ✓
                </span>
                <p class="text-slate-700 leading-snug">
                  Precinto de seguridad intacto de fábrica con garantía de pesaje exacto.
                </p>
              </div>
            </div>

          </div>

          <!-- Acciones de Pedido: Botón WhatsApp Profesional y Enlace de Configuración -->
          <div class="mt-5 pt-3 border-t border-slate-100 flex flex-col gap-2">
            <a
              href={`https://wa.me/${contact.whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(`Hola Línea Gas, deseo pedir un balón de ${brand.name}.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#2ee020] via-[#25c818] to-[#1ea812] hover:brightness-105 active:scale-95 py-3 px-4 text-xs sm:text-sm font-extrabold text-white shadow-md shadow-emerald-900/10 transition-all cursor-pointer"
            >
              <WhatsAppIcon className="h-5 w-5 shrink-0" size={20} />
              <span>Pedir {brand.name} por WhatsApp</span>
            </a>

            <button
              type="button"
              data-brand-target={brand.id}
              class="catalog-select-hero-btn w-full text-center text-xs font-bold text-slate-500 hover:text-brand-navy py-1 transition-colors cursor-pointer"
            >
              o configurar pedido arriba en el inicio ↑
            </button>
          </div>

        </div>
      ))}
    </div>

    <!-- Garantías y Certificación al Pie del Catálogo -->
    <div class="mt-10 rounded-2xl bg-white p-5 sm:p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3.5">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-brand-orange-dark">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h4 class="font-heading text-sm sm:text-base font-bold text-brand-navy">
            Compromiso de Calidad y Pesaje en Cada Entrega
          </h4>
          <p class="text-xs text-content-muted">
            Todos nuestros cilindros pasan por rigurosos controles técnicos antes de salir a reparto en Chiclayo.
          </p>
        </div>
      </div>
      <a
        href="#inicio"
        class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-brand-orange-dark hover:bg-[#A63F05] text-white text-xs sm:text-sm font-bold py-2.5 px-5 shadow-sm transition active:scale-95"
      >
        <span>Ir al pedido arriba</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- Script para alternar la vista entre 10 kg y 45 kg y para enlazar con el configurador del Hero -->
<script>
  // 1. Alternar fotos entre 10 kg y 45 kg
  const specTabs = document.querySelectorAll<HTMLButtonElement>('.spec-tab-btn');

  specTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const brandId = tab.getAttribute('data-brand');
      const size = tab.getAttribute('data-size');
      const img10 = tab.getAttribute('data-img10') || '';
      const img45 = tab.getAttribute('data-img45') || '';
      const imgEl = document.getElementById(`catalog-img-${brandId}`) as HTMLImageElement | null;

      if (!imgEl || !brandId) return;

      // Actualizar estado activo de las pestañas
      const parent = tab.parentElement;
      if (parent) {
        parent.querySelectorAll('.spec-tab-btn').forEach((b) => {
          b.classList.remove('bg-brand-navy', 'text-white', 'shadow-2xs');
          b.classList.add('text-slate-600');
        });
        tab.classList.add('bg-brand-navy', 'text-white', 'shadow-2xs');
        tab.classList.remove('text-slate-600');
      }

      // Transición fluida de imagen
      imgEl.style.opacity = '0.35';
      imgEl.style.transform = 'scale(0.96)';
      
      setTimeout(() => {
        if (size === '45' && img45) {
          imgEl.src = img45;
        } else {
          imgEl.src = img10;
        }
        imgEl.style.opacity = '1';
        imgEl.style.transform = 'scale(1.0)';
      }, 90);
    });
  });

  // 2. Conectar botón secundario "o configurar pedido arriba en el inicio" con el configurador
  const heroSelectBtns = document.querySelectorAll<HTMLButtonElement>('.catalog-select-hero-btn');
  heroSelectBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const brandId = btn.getAttribute('data-brand-target');
      if (brandId) {
        const heroBrandBtn = document.querySelector(`.hero-brand-btn[data-brand-id="${brandId}"]`) as HTMLButtonElement | null;
        if (heroBrandBtn) {
          heroBrandBtn.click();
        }
        document.getElementById('inicio')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
