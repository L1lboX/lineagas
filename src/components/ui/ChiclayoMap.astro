---
import districts from '../../data/chiclayo_districts.json';
---

<div class="relative w-full bg-transparent flex flex-col items-center select-none">
  
  <!-- Tooltip Flotante Dinámico que sigue el cursor con el nombre de cualquier zona (Desktop) -->
  <div
    id="map-tooltip"
    class="pointer-events-none absolute z-30 hidden -translate-x-1/2 -translate-y-full rounded-xl bg-brand-navy/95 px-3.5 py-2 text-xs text-white shadow-2xl border border-white/20 backdrop-blur-md transition-opacity duration-150"
    role="tooltip"
  >
    <p id="tooltip-text" class="font-heading font-extrabold text-sm text-white tracking-wide"></p>
    <p id="tooltip-status" class="text-[11px] mt-0.5 font-medium"></p>
  </div>

  <!-- SVG del Mapa Vectorial de Chiclayo (Sin fondo, 100% responsivo con viewBox) -->
  <div class="w-full max-w-full overflow-hidden flex justify-center">
    <svg
      id="chiclayo-vector-map"
      viewBox="0 0 725 745"
      class="w-full h-auto max-h-[520px] drop-shadow-sm touch-manipulation"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="Mapa de cobertura de reparto en Chiclayo"
    >
      <!-- Distritos: Zonas con reparto en Naranja, otras zonas en gris sólido visible (Contorno siempre nítido) -->
      <g id="districts-paths">
        {districts.map((d) => {
          const isCovered = d.hasCoverage;
          return (
            <path
              id={`district-path-${d.id}`}
              d={d.d}
              data-id={d.id}
              data-name={d.name}
              data-covered={String(isCovered)}
              class={`district-poly cursor-pointer transition-colors duration-150 ${
                isCovered
                  ? "fill-brand-orange/35 stroke-brand-orange stroke-[1.8] hover:fill-brand-orange/65 hover:stroke-brand-orange-dark hover:stroke-[2.5]"
                  : "fill-slate-100 stroke-slate-400 stroke-[1.6] hover:fill-slate-200 hover:stroke-slate-600 hover:stroke-[2.2]"
              }`}
            >
              <title>{d.name} {isCovered ? "(Cobertura de reparto activa)" : "(Consultar cobertura)"}</title>
            </path>
          );
        })}
      </g>
    </svg>
  </div>

  <!-- Barra Dinámica de Zona Seleccionada (Excelente UX táctil para smartphones y tablets) -->
  <div
    id="mobile-district-info"
    class="mt-3 w-full max-w-md rounded-2xl bg-surface-soft p-3 sm:p-4 border border-slate-200 text-center shadow-xs transition-all duration-200"
  >
    <div id="district-placeholder-msg" class="text-xs text-slate-500 font-medium">
      👆 Toca o pasa el cursor sobre cualquier zona para ver su nombre y cobertura
    </div>
    <div id="district-active-details" class="hidden text-center py-0.5">
      <p id="info-district-name" class="font-heading font-extrabold text-sm sm:text-base text-brand-navy leading-tight"></p>
      <p id="info-district-status" class="text-xs font-semibold mt-0.5"></p>
    </div>
  </div>

  <!-- Leyenda clara inferior -->
  <div class="mt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-content-muted">
    <div class="flex items-center gap-2">
      <span class="h-3.5 w-3.5 rounded-full bg-brand-orange border border-brand-orange-dark shadow-xs"></span>
      <span class="font-bold text-brand-navy">Zonas con Cobertura de Reparto (Naranja)</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="h-3.5 w-3.5 rounded-full bg-slate-200 border border-slate-400"></span>
      <span>Otras Zonas de la Provincia</span>
    </div>
  </div>

</div>

<style>
  /* Resaltado controlado sin alterar el brillo global ni perder el contorno */
  .district-poly.is-active-district[data-covered="true"] {
    fill: rgba(245, 102, 10, 0.65) !important;
    stroke: #C84D08 !important;
    stroke-width: 2.8px !important;
    filter: drop-shadow(0 2px 4px rgba(200, 77, 8, 0.3));
  }

  .district-poly.is-active-district[data-covered="false"] {
    fill: #cbd5e1 !important;
    stroke: #334155 !important;
    stroke-width: 2.2px !important;
    filter: drop-shadow(0 2px 4px rgba(51, 65, 85, 0.2));
  }
</style>

<script>
  // Interactividad completa: Mouse (Desktop) y Táctil (Móvil)
  const paths = document.querySelectorAll<SVGPathElement>('.district-poly');
  const tooltip = document.getElementById('map-tooltip');
  const tooltipText = document.getElementById('tooltip-text');
  const tooltipStatus = document.getElementById('tooltip-status');
  const svg = document.getElementById('chiclayo-vector-map');

  // Elementos de la barra de información inferior
  const placeholderMsg = document.getElementById('district-placeholder-msg');
  const activeDetails = document.getElementById('district-active-details');
  const infoName = document.getElementById('info-district-name');
  const infoStatus = document.getElementById('info-district-status');

  function selectDistrict(path: SVGPathElement) {
    const name = path.getAttribute('data-name') || '';
    const isCovered = path.getAttribute('data-covered') === 'true';

    // Resaltar visualmente sin usar brightness (evita que el contorno se lave o desaparezca en blanco)
    paths.forEach(p => p.classList.remove('is-active-district'));
    path.classList.add('is-active-district');

    // Actualizar tooltip flotante
    if (tooltip && tooltipText && tooltipStatus) {
      tooltipText.textContent = name;
      if (isCovered) {
        tooltipStatus.textContent = '✓ Zona con cobertura activa de reparto';
        tooltipStatus.className = 'text-[11px] text-amber-300 font-semibold mt-0.5';
      } else {
        tooltipStatus.textContent = '○ Fuera de ruta habitual (Consultar disponibilidad)';
        tooltipStatus.className = 'text-[11px] text-slate-300 font-medium mt-0.5';
      }
      tooltip.classList.remove('hidden');
    }

    // Actualizar barra de información inferior (útil para móviles y accesibilidad)
    if (placeholderMsg && activeDetails && infoName && infoStatus) {
      placeholderMsg.classList.add('hidden');
      activeDetails.classList.remove('hidden');
      infoName.textContent = name;
      
      if (isCovered) {
        infoStatus.textContent = '✓ Cobertura directa de reparto activa';
        infoStatus.className = 'text-xs font-bold text-brand-orange-dark';
      } else {
        infoStatus.textContent = '○ Zona por coordinar con Línea Gas';
        infoStatus.className = 'text-xs font-semibold text-slate-500';
      }
    }
  }

  function hideTooltip() {
    if (tooltip) {
      tooltip.classList.add('hidden');
    }
  }

  function resetActivePaths() {
    hideTooltip();
    paths.forEach(p => p.classList.remove('is-active-district'));
  }

  paths.forEach((path) => {
    // Eventos Mouse: Al salir de cualquier polígono se remueve su clase activa
    path.addEventListener('mouseenter', () => selectDistrict(path));
    path.addEventListener('mouseleave', () => {
      hideTooltip();
      path.classList.remove('is-active-district');
    });

    path.addEventListener('mousemove', (e) => {
      if (tooltip && svg) {
        const rect = svg.getBoundingClientRect();
        tooltip.style.left = `${e.clientX - rect.left}px`;
        tooltip.style.top = `${e.clientY - rect.top - 12}px`;
      }
    });

    // Eventos Táctiles (Smartphones y Tablets)
    path.addEventListener('click', () => {
      selectDistrict(path);
    });
  });

  // Al salir del SVG completo hacia afuera, se restablecen todos los distritos a su contorno nítido normal
  svg?.addEventListener('mouseleave', resetActivePaths);
</script>
