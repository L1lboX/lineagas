---
import WhatsAppIcon from '../common/WhatsAppIcon.astro';
import { site, getWhatsAppUrl, getPhoneTel } from '../../data/site';

const defaultMessage = `Hola ${site.brand}, deseo realizar un pedido de gas.`;
const whatsappUrl = getWhatsAppUrl(defaultMessage);
const phoneTel = getPhoneTel();

// Formato de números para visualización
const formattedWhatsApp = site.contact.whatsappNumber 
  ? (site.contact.whatsappNumber.startsWith('51') ? `+${site.contact.whatsappNumber.slice(0, 2)} ${site.contact.whatsappNumber.slice(2)}` : site.contact.whatsappNumber)
  : "927 089 151";

const formattedPhone = site.contact.phoneNumber || "074 603053";
---

<!-- Widgets Laterales Desplegables: WhatsApp y Teléfono Directo (Mismo Diseño Desplegable Lateral) -->
<aside
  id="floating-contact-widget"
  class="fixed right-0 top-1/2 -translate-y-1/2 z-40 flex flex-col gap-2.5 sm:gap-3 items-end select-none"
  aria-label="Atención directa por WhatsApp y Teléfono"
>
  <!-- 1. Botón Lateral Desplegable: WhatsApp (Diseño Original Idéntico) -->
  {whatsappUrl ? (
    <a
      id="whatsapp-lateral-link"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="lateral-pill group flex items-center bg-gradient-to-r from-[#32cf1b] via-[#28ba13] to-[#1da50c] text-white rounded-l-full shadow-2xl py-2 sm:py-2.5 pl-3 sm:pl-3.5 pr-6 sm:pr-7 transition-all duration-300 ease-out translate-x-[calc(100%-60px)] sm:translate-x-[calc(100%-66px)] hover:translate-x-0 focus-visible:translate-x-0 cursor-pointer max-w-[calc(100vw-16px)]"
      aria-label={`Central de pedidos por WhatsApp: ${formattedWhatsApp}`}
    >
      <!-- Icono de WhatsApp en círculo -->
      <div class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full bg-white/10 ring-2 ring-white/40 group-hover:scale-105 transition-transform">
        <WhatsAppIcon className="h-7 w-7 sm:h-8 sm:w-8" size={32} />
      </div>

      <!-- Texto que se despliega al pasar el mouse o al tocar en móvil -->
      <div class="ml-3 sm:ml-3.5 pr-1 sm:pr-2 text-left whitespace-nowrap">
        <span class="block text-[11px] sm:text-[13px] font-bold text-white/95 leading-tight tracking-wide drop-shadow-sm">
          Central de pedidos
        </span>
        <span class="block font-heading text-base sm:text-xl font-extrabold text-white tracking-wider leading-none mt-1 drop-shadow-sm">
          {formattedWhatsApp}
        </span>
      </div>
    </a>
  ) : (
    <button
      id="whatsapp-lateral-btn"
      type="button"
      class="btn-demo-action lateral-pill group flex items-center bg-gradient-to-r from-[#32cf1b] via-[#28ba13] to-[#1da50c] text-white rounded-l-full shadow-2xl py-2 sm:py-2.5 pl-3 sm:pl-3.5 pr-6 sm:pr-7 transition-all duration-300 ease-out translate-x-[calc(100%-60px)] sm:translate-x-[calc(100%-66px)] hover:translate-x-0 focus-visible:translate-x-0 cursor-pointer text-left max-w-[calc(100vw-16px)]"
      data-msg={defaultMessage}
      data-context={`Central de pedidos WhatsApp (Línea: <strong>${formattedWhatsApp}</strong>).`}
      aria-label={`Central de pedidos por WhatsApp: ${formattedWhatsApp}`}
    >
      <!-- Icono de WhatsApp en círculo -->
      <div class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full bg-white/10 ring-2 ring-white/40 group-hover:scale-105 transition-transform">
        <WhatsAppIcon className="h-7 w-7 sm:h-8 sm:w-8" size={32} />
      </div>

      <!-- Texto que se despliega al pasar el mouse o al tocar en móvil -->
      <div class="ml-3 sm:ml-3.5 pr-1 sm:pr-2 text-left whitespace-nowrap">
        <span class="block text-[11px] sm:text-[13px] font-bold text-white/95 leading-tight tracking-wide drop-shadow-sm">
          Central de pedidos
        </span>
        <span class="block font-heading text-base sm:text-xl font-extrabold text-white tracking-wider leading-none mt-1 drop-shadow-sm">
          {formattedWhatsApp}
        </span>
      </div>
    </button>
  )}

  <!-- 2. Botón Lateral Desplegable: Teléfono (Mismo Diseño Desplegable Idéntico en Azul con Telefonito) -->
  {phoneTel ? (
    <a
      id="phone-lateral-link"
      href={phoneTel}
      class="lateral-pill group flex items-center bg-gradient-to-r from-[#2563eb] via-[#1d4ed8] to-[#11185C] text-white rounded-l-full shadow-2xl py-2 sm:py-2.5 pl-3 sm:pl-3.5 pr-6 sm:pr-7 transition-all duration-300 ease-out translate-x-[calc(100%-60px)] sm:translate-x-[calc(100%-66px)] hover:translate-x-0 focus-visible:translate-x-0 cursor-pointer max-w-[calc(100vw-16px)]"
      aria-label={`Llamada directa a central telefónica: ${formattedPhone}`}
    >
      <!-- Icono del Telefonito en círculo -->
      <div class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full bg-white/10 ring-2 ring-white/40 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-7 sm:w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </div>

      <!-- Texto que se despliega al pasar el mouse o al tocar en móvil -->
      <div class="ml-3 sm:ml-3.5 pr-1 sm:pr-2 text-left whitespace-nowrap">
        <span class="block text-[11px] sm:text-[13px] font-bold text-white/95 leading-tight tracking-wide drop-shadow-sm">
          Llamada directa
        </span>
        <span class="block font-heading text-base sm:text-xl font-extrabold text-white tracking-wider leading-none mt-1 drop-shadow-sm">
          {formattedPhone}
        </span>
      </div>
    </a>
  ) : (
    <div
      class="lateral-pill group flex items-center bg-gradient-to-r from-[#2563eb] via-[#1d4ed8] to-[#11185C] text-white rounded-l-full shadow-2xl py-2 sm:py-2.5 pl-3 sm:pl-3.5 pr-6 sm:pr-7 transition-all duration-300 ease-out translate-x-[calc(100%-60px)] sm:translate-x-[calc(100%-66px)] hover:translate-x-0 focus-visible:translate-x-0 max-w-[calc(100vw-16px)]"
    >
      <div class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full bg-white/10 ring-2 ring-white/40">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-7 sm:w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </div>
      <div class="ml-3 sm:ml-3.5 pr-1 sm:pr-2 text-left whitespace-nowrap">
        <span class="block text-[11px] sm:text-[13px] font-bold text-white/95 leading-tight tracking-wide drop-shadow-sm">
          Llamada directa
        </span>
        <span class="block font-heading text-base sm:text-xl font-extrabold text-white tracking-wider leading-none mt-1 drop-shadow-sm">
          {formattedPhone}
        </span>
      </div>
    </div>
  )}
</aside>

<script>
  // Delegación de eventos para botones con clase .btn-demo-action
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('.btn-demo-action') as HTMLElement | null;
    if (target) {
      const msg = target.getAttribute('data-msg') || '';
      const context = target.getAttribute('data-context') || '';
      window.dispatchEvent(new CustomEvent('open-demo-dialog', {
        detail: { message: msg, context: context }
      }));
    }
  });

  // Soporte táctil mejorado para dispositivos móviles para ambos botones laterales
  const pills = document.querySelectorAll('.lateral-pill');
  pills.forEach((pill) => {
    let isOpen = false;
    pill.addEventListener('touchstart', () => {
      if (!isOpen) {
        isOpen = true;
        pill.classList.remove('translate-x-[calc(100%-60px)]', 'sm:translate-x-[calc(100%-66px)]');
        pill.classList.add('translate-x-0');
        // Auto repliegue después de 4.5 segundos si el usuario no interactúa más
        setTimeout(() => {
          isOpen = false;
          pill.classList.add('translate-x-[calc(100%-60px)]', 'sm:translate-x-[calc(100%-66px)]');
          pill.classList.remove('translate-x-0');
        }, 4500);
      }
    }, { passive: true });
  });
</script>
