---
interface Props {
  caption?: string;
  subtext?: string;
  aspect?: string; // e.g. "aspect-square", "aspect-video", "aspect-[4/3]"
  className?: string;
}

const {
  caption = "Imagen no encontrada / pendiente",
  subtext = "Espacio reservado para foto oficial",
  aspect = "aspect-[4/3]",
  className = "",
} = Astro.props;
---

<div
  class={`relative flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50/80 p-6 text-center transition-colors hover:border-slate-400 ${aspect} ${className}`}
  role="img"
  aria-label={caption}
>
  <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-slate-200/80 text-slate-500 shadow-inner">
    <!-- Icono de imagen no encontrada / sin imagen -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-7 w-7"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.75"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
      />
      <!-- Línea diagonal indicando pendiente/sin imagen -->
      <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    </svg>
  </div>

  <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100/90 px-2.5 py-0.5 text-xs font-semibold text-amber-900">
    <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span>
    {caption}
  </span>

  {subtext && (
    <p class="mt-2 max-w-[220px] text-xs text-slate-500">
      {subtext}
    </p>
  )}
</div>
