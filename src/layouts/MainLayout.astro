---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import DemoModal from '../components/ui/DemoModal.astro';
import FloatingContact from '../components/ui/FloatingContact.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.seo.title,
  description = site.seo.description,
} = Astro.props;

// Schema LocalBusiness estructurado (sin inventar coordenadas ni datos falsos)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": site.brand,
  "description": description,
  "telephone": site.contact.phoneNumber || undefined,
  "email": site.contact.email,
  "openingHours": site.contact.businessHours !== "Lunes a Domingo: Horario por confirmar" ? site.contact.businessHours : undefined,
  "priceRange": "$$",
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.brand} />

    <!-- Favicon en SVG vectorial con la llama oficial -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='15' fill='%2311185C'/><path d='M16 4C16 4 20 10 20 14C20 15.5 19.5 17 18.5 18C20 16.5 24 16.5 24 22C24 27 19.5 30 15 30C10 30 7 26 7 21C7 15 13 9 16 4Z' fill='%23F5660A'/><path d='M15 15C15 15 17 18 17 21C17 23 15.5 25 14 25C12.5 25 11 23 11 20C11 17 13.5 15.5 15 15Z' fill='%23F4A20E'/></svg>" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-content antialiased overflow-x-hidden">
    <!-- Header Fijo / Sticky -->
    <Header />

    <!-- Contenido Principal -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Botones Flotantes y Modal Accesible -->
    <FloatingContact />
    <DemoModal />
  </body>
</html>
